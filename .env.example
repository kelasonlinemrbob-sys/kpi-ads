# Postgres connection string
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/kpi_ads
# Secret for signing session cookies — generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Calendar used for "today", daily reports and monthly targets
APP_TIMEZONE=Asia/Jakarta
# Show the demo-account hint on the login page in production (it always shows in dev)
SHOW_DEMO_ACCOUNTS=false

# --- Generate laporan dari Ads API (opsional) ---
# Meta Marketing API: sebaiknya diisi dari aplikasi (Settings → Koneksi Meta Ads, disimpan terenkripsi).
# Satu koneksi tim diisi supervisor; advertiser hanya memilih akun iklannya. META_ACCESS_TOKEN tidak dipakai sebagai fallback.
# Pakai token System User dengan masa berlaku "Tidak pernah" + izin ads_read agar tidak kedaluwarsa.
META_ACCESS_TOKEN=
META_API_VERSION=v24.0
# Action type yang dihitung sebagai "Result lead" (yang pertama ditemukan dipakai)
META_LEAD_ACTION_TYPES=lead,onsite_conversion.lead_grouped,offsite_conversion.fb_pixel_lead
# Google Ads API: satu koneksi tim diisi supervisor lewat Settings → Integrasi (terenkripsi); advertiser memilih akunnya.
# Variabel OAuth lama hanya dipertahankan sebagai fallback integrasi Google Sheets lama.
# Akses produksi diajukan di Google Cloud project; developer token tidak diperlukan.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# ID akun MCC (manager) bila akses lewat MCC, tanpa tanda "-"
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# --- Analisa AI (Kie.ai, Claude) — opsional ---
# API key tim diisi supervisor di Settings → Integrasi → Kie AI (terenkripsi); semua anggota memakainya. Variabel di bawah hanya untuk override.
# KIE_BASE_URL=https://api.kie.ai/claude
# KIE_MODEL=claude-opus-5-5
# Model untuk "Analisa creative" per konten (menonton video / melihat gambar)
# KIE_GEMINI_MODEL=gemini-3-8-flash
# Batas analisa per user per 24 jam (tiap analisa memotong kredit Kie)
AI_ANALYSIS_DAILY_LIMIT=30
# Model untuk Analisa AI di Ringkasan: gemini (default, melihat gambar, jauh lebih murah) atau claude
AI_SUMMARY_MODEL=gemini
# Kirim gambar creative di Ringkasan. Kosongkan = otomatis (nyala untuk Gemini, mati untuk Claude,
# karena Claude di Kie.ai membuang gambar tanpa error)
# AI_ANALYSIS_IMAGES=

# --- WhatsApp (Baileys) — worker: pnpm wa:worker ---
# Level log Baileys (silent | error | warn | info | debug)
WA_LOG_LEVEL=warn
# Pengaman anti-banned (per nomor WhatsApp). Default sudah aman untuk laporan harian.
# Jeda sebelum laporan dikirim; edit laporan dalam jeda ini digabung jadi satu pesan
WA_SEND_DELAY_SEC=60
# Jeda minimum antar pesan dari nomor yang sama (ditambah acak 0–100%)
WA_MIN_GAP_SEC=20
# Batas pesan per nomor; lebihnya ditahan dan dikirim otomatis setelah batas turun
WA_MAX_PER_HOUR=20
WA_MAX_PER_DAY=60

# Password reset email (Gmail App Password, never your normal Google password)
APP_URL=https://ads.lkbimrbob.com
# Contact shown on /privacy-policy for data requests (Meta / Google app review). Empty = the contact on lkbimrbob.com.
PRIVACY_CONTACT_EMAIL=
PRIVACY_CONTACT_WHATSAPP=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=KPI Ads

# Public IPv4 of this VPS for self-service form domains. Requires kpiads-form-domains.timer.
FORM_DOMAIN_TARGET_IP=
