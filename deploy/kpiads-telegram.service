[Unit]
Description=KPI Ads Telegram report delivery
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=kpiads
Group=kpiads
WorkingDirectory=/srv/kpiads/current
ExecStart=/usr/local/bin/node --env-file=/srv/kpiads/shared/.env --conditions=react-server --import tsx src/telegram/worker.mts
TimeoutStartSec=6min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/kpiads
UMask=0027
